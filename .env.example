# Copy to .env for local Docker Compose. Docker Compose reads .env from the repo root.
# Export the same values in your shell before starting the backend with Maven.

DB_NAME=opspilot
DB_USERNAME=opspilot
DB_PASSWORD=change-me-local-dev
MYSQL_ROOT_PASSWORD=change-me-root-local-dev
MYSQL_PORT=3306

# Optional backend overrides (defaults shown)
# DB_HOST=localhost
# DB_PORT=3306
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# JWT_EXPIRATION_SECONDS=3600
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SERVER_PORT=8080
