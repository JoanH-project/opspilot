# Copy to .env for local Docker Compose. Docker Compose reads .env from the repo root.
# Export the same values in your shell before starting the backend with Maven.

DB_NAME=opspilot
DB_USERNAME=opspilot
DB_PASSWORD=change-me-local-dev
MYSQL_ROOT_PASSWORD=change-me-root-local-dev
MYSQL_PORT=3306

# Optional backend overrides (defaults shown)
# DB_HOST=localhost
# DB_PORT=3306
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# JWT_EXPIRATION_SECONDS=3600
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# SERVER_PORT=8080

# V3 isolated local stack. Generate these in your shell; do not commit real values.
# V3_DB_NAME=opspilot
# V3_DB_USERNAME=opspilot
# V3_MYSQL_HOST_PORT=3310
# V3_BACKEND_HOST_PORT=8084
# V3_MANAGEMENT_HOST_PORT=8085
# V3_DB_PASSWORD=
# V3_MYSQL_ROOT_PASSWORD=
# V3_REDIS_PASSWORD=
# V3_JWT_SECRET=
# V3_METRICS_PASSWORD=
# V3_AI_INTERNAL_TOKEN=
# V3_CORS_ALLOWED_ORIGINS=http://localhost:5173
# V3_KNOWLEDGE_MIN_SCORE=0.70
